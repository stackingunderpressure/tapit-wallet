# Tapit Wallet env. Copy to .env.local and fill in.
# NEVER commit real values. Only env-var NAMES live in the repo.

# Supabase project URL — get from your Supabase project dashboard.
VITE_SUPABASE_URL=

# Supabase anon key — public-safe; RLS is what gates access. Get
# from the same dashboard. Do NOT use the service-role key here.
VITE_SUPABASE_ANON_KEY=

# --- Beat the HODL arena price oracle (optional) ---
# Public endpoint of the signed price oracle (the netlify/functions/
# price-oracle function, routed at /api/price-oracle). When set together
# with the pubkey below, the arena offers a verified "Fetch signed price".
VITE_ARENA_ORACLE_URL=

# The oracle's x-only BIP340 public key (hex) — clients verify every
# signed round against this. Public-safe. It is the pair of the server-
# only ARENA_ORACLE_PRIVATE_KEY (set in Netlify env, NEVER committed and
# NEVER prefixed VITE_).
VITE_ARENA_ORACLE_PUBKEY=
