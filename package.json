{
  "name": "tapit-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sovereign identity wallet — keypair holder + Merkle holder of signed attestations.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix tapit-attest run build && npm --prefix bip341-psbt-signer run build",
    "build": "tsc -p tsconfig.json && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check-bundle": "node scripts/bundle-budget.mjs",
    "test:baseline": "node scripts/test-baseline.mjs",
    "test:baseline:write": "node scripts/test-baseline.mjs --write",
    "doctrine:check": "node scripts/doctrine-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:baseline && npm run doctrine:check"
  },
  "dependencies": {
    "@dynastytrust/bip341-psbt-signer": "file:./bip341-psbt-signer",
    "@noble/hashes": "^1.7.2",
    "@supabase/supabase-js": "^2.45.0",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tapit-attest": "file:./tapit-attest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
